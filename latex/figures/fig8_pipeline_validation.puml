@startuml fig8_pipeline_validation
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 11
skinparam activityBackgroundColor #FFFFFF
skinparam activityBorderColor #333333
skinparam activityBorderThickness 1.5
skinparam arrowColor #333333
skinparam diamondBackgroundColor #FFFFFF
skinparam diamondBorderColor #333333
skinparam noteBorderColor #888888
skinparam noteBackgroundColor #F8F8F8

start

:Raw RIPE Atlas DNS result\n(JSON from REST API);

' Filter 1
if (abuf field present?) then (no)
  :Classify: **TIMEOUT**\nretain for reliability analysis;
  stop
else (yes)
endif

' Filter 2
if (|timestamp - scheduled_time| > 4h?) then (yes)
  :Classify: **SCHED_REJECTED**\nexclude from temporal analysis;
  stop
else (no)
  if (2h < |delta| <= 4h?) then (yes)
    :Flag: **SCHED_WARNING**\nretain with annotation;
  else (no)
  endif
endif

' Filter 3
if (RCODE == NOERROR?) then (no)
  if (RCODE == NXDOMAIN\nor REFUSED?) then (yes)
    :Check for censorship pattern\n(cross-probe in same country);
    if (Censorship suspected?) then (yes)
      :Classify: **CENSORSHIP_FLAG**\nretain for Q3 analysis;
    else (no)
      :Classify: **DNS_ERROR**\nexclude from Q1/Q2;
      stop
    endif
  else (no)
    :Classify: **SERVFAIL**\nretain for DNSSEC analysis;
    stop
  endif
else (yes)
  if (Answer section empty?) then (yes)
    :Classify: **NO_ANSWER**\nexclude from content analysis;
    stop
  else (no)
  endif
endif

' Filter 4
:Extract answer IPs\nfrom parsed abuf;
if (IPs consistent with\n90%+ of same-region probes?) then (no)
  :Flag: **PROXY_SUSPECT**\nmark for manual inspection;
else (yes)
endif

:Result: **VALID**;
:Enrich with probe metadata\n(country, ASN, coordinates)\nand NSID → PoP mapping;

:Write to Avro archive;

stop

@enduml
