# Data files (except examples)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Output files
output/*.pdf
output/*.png
output/*.jpg
output/*.svg
output/*.aux
output/*.bcf
output/*.log
output/*.out
output/*.run.xml
output/*.toc
