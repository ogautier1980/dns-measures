@inproceedings{Cicalese2015,
  title = {Characterizing {{IPv4}} Anycast Adoption and Deployment},
  booktitle = {Proceedings of the 11th {{ACM Conference}} on {{Emerging Networking Experiments}} and {{Technologies}}},
  author = {Cicalese, Danilo and Augé, Jordan and Joumblatt, Diana and Friedman, Timur and Rossi, Dario},
  date = {2015-12-01},
  series = {{{CoNEXT}} '15},
  pages = {1--13},
  publisher = {Association for Computing Machinery},
  location = {New York, NY, USA},
  doi = {10.1145/2716281.2836101},
  url = {https://dl.acm.org/doi/10.1145/2716281.2836101},
  urldate = {2026-03-22},
  abstract = {This paper provides a comprehensive picture of IP-layer anycast adoption in the current Internet. We carry on multiple IPv4 anycast censuses, relying on latency measurement from PlanetLab. Next, we leverage our novel technique for anycast detection, enumeration, and geolocation [17] to quantify anycast adoption in the Internet. Our technique is scalable and, unlike previous efforts that are bound to exploiting DNS, is protocol-agnostic. Our results show that major Internet companies (including tier-1 ISPs, over-the-top operators, Cloud providers and equipment vendors) use anycast: we find that a broad range of TCP services are offered over anycast, the most popular of which include HTTP and HTTPS by anycast CDNs that serve websites from the top-100k Alexa list. Additionally, we complement our characterization of IPv4 anycast with a description of the challenges we faced to collect and analyze large-scale delay measurements, and the lessons learned.},
  isbn = {978-1-4503-3412-9}
}

@inproceedings{Li2025,
  title = {Measurement and {{Analysis}} of a {{Global-Scale CDN}} -- {{Locality}}, {{Dynamics}}, and {{Load Balance}}},
  booktitle = {Proceedings of the 20th {{Asian Internet Engineering Conference}}},
  author = {Li, Guo-Cheng and Huang, Polly},
  date = {2025-11-24},
  series = {{{AINTEC}} '25},
  pages = {9--17},
  publisher = {Association for Computing Machinery},
  location = {New York, NY, USA},
  doi = {10.1145/3763400.3763406},
  url = {https://dl.acm.org/doi/10.1145/3763400.3763406},
  urldate = {2026-03-22},
  abstract = {Content Delivery network (CDN) is a critical part of the Internet service design. It functions as a distributed cache of the content to deliver. Its scale, distribution and caching scheme concerns the user experience that the service providers seek to improve. To facilitate the design and performance analysis process, we measure and analyze the CDN of a popular live video service – Twitch. In that, we conducted a 30-day, global-scale crawl that mapped 2166 edge servers across major continents. The effort, as far as we know, is the most widespread in time-span and geo-diversity in recent years. From the data collected, we observed a two-level hierarchy in the edge server (i.e., the video cache) selection process, similar to that has been reported in[16]. What we see new are 3 salient properties on the locality, dynamics, and load distribution of the servers. (1) The system maintains the viewer-server proximity at the continent granularity. (2) There is a slow rotation of the server clusters over time, and (3) The load distribution is approximately uniform random at both levels of the hierarchy. The tool, methodology, and the findings are important intermediate steps to cost-effective data collection and long-term study of CDNs in operation.},
  isbn = {979-8-4007-1846-5}
}

